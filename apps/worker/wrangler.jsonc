{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cove-tools",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs records full request URLs — including a token-in-path /mcp/<token> URL.
  // Set "head_sampling_rate": 0 here if dashboard log access is a concern (see README).
  "observability": { "enabled": true },

  "d1_databases": [
    { "binding": "DB", "database_name": "cove-tools", "database_id": "REPLACE_ME" }
  ],

  // Non-secret config — edit for your setup. Secrets (wrangler secret put ...):
  //   YNAB_ACCESS_TOKEN — from app.ynab.com → Account Settings → Developer Settings
  //   MCP_AUTH_TOKEN     — any long random string; becomes the Bearer token for /mcp
  "vars": {
    "PLAN_ID": "last-used",
    "WORKER_ALLOW_WRITES": "0"
  }
}
